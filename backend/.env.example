# ──────────────────────────────────────────────────────────
#  Maxim Broadcast v1.5.0 — Environment Variables
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ─── Auth ─────────────────────────────────────────────────
# REQUIRED: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-replace-this
JWT_EXPIRY=30d

# ─── Database ─────────────────────────────────────────────
DB_TYPE=sqlite
DB_PATH=./db/maxim.db
# Optional PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/maxim

# ─── Frontend / CORS ──────────────────────────────────────
FRONTEND_URL=https://your-railway-url.railway.app
CORS_ORIGIN=https://your-railway-url.railway.app

# ─── OBS WebSocket (optional) ─────────────────────────────
OBS_WS_HOST=
OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# ─── Storage ──────────────────────────────────────────────
MEDIA_STORAGE_PATH=./uploads/media
AUDIO_PATH=./uploads/audio
RECORDINGS_PATH=./recordings

# ─── Multi-Stream (requires FFmpeg installed) ─────────────
FFMPEG_PATH=ffmpeg

# ─── Features (set to 'false' to disable) ─────────────────
ENABLE_CHANNELS=true
ENABLE_PLAYOUT=true
ENABLE_MULTISTREAM=true
ENABLE_RADIOSYNC=true
ENABLE_AI_FEATURES=true
DEMO_MODE=false

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
